# Copy this file to .env and fill real values before running Docker Compose.
# Never commit .env to Git.

# --- Spring Profile & Schema ---
SPRING_PROFILES_ACTIVE=prod
# Use "update" on first deployment (or until Flyway is added), then switch to "validate"
JPA_DDL_AUTO=update

# --- Database (Supabase PostgreSQL Recommended for 1GB VM) ---
# In Supabase: Project Settings -> Database -> Connection string -> URI / JDBC (Session Pooler mode)
# Example: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://<your-pooler-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=your_supabase_db_password
DB_POOL_SIZE=5

# --- Eduportal App Config ---
JWT_SECRET=replace_with_at_least_64_char_random_hex_or_base64_secret
CORS_ALLOWED_ORIGINS=https://eduportal.ignishers.in,http://localhost:3000,http://localhost:5173
PUBLIC_REGISTRATION_ENABLED=false

# --- JVM Memory Budget (Tuned for 1GB AMD Micro VM) ---
EDUPORTAL_JAVA_OPTS="-Xms128m -Xmx280m -XX:MaxMetaspaceSize=110m -XX:+UseSerialGC"

# --- Smart Attendance Tunables ---
ATTENDANCE_QR_STEP_SECONDS=5
ATTENDANCE_CHECKIN_WINDOW_SECONDS=20
ATTENDANCE_FACE_THRESHOLD=0.75
ATTENDANCE_DEFAULT_RADIUS_METERS=100

# --- OCI Deployment / Registry ---
GHCR_IMAGE=ghcr.io/your-github-username/eduportal-backend:latest

